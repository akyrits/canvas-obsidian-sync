# Canvas -> Calendar -> "Calendar Feed" link (Account > Settings also has it).
# Treat this like a password: anyone with this URL can read your Canvas calendar.
CANVAS_ICS_URL=https://fau.instructure.com/feeds/calendars/user_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.ics

# Absolute path to your Obsidian vault's root folder.
VAULT_PATH=C:/Users/kyrit/ObsidianVault

# Both paths below are relative to VAULT_PATH.
BOARD_RELATIVE_PATH=Boards/Assignments.md
ASSIGNMENTS_RELATIVE_DIR=School

# An assignment due within this many days lands in "This Week" instead of "Backlog".
DUE_SOON_DAYS=7

# Your IANA time zone. Canvas assignment due times (and the board/dashboard's
# "Today"/"This week" categorization) are interpreted in this zone.
TIMEZONE=America/New_York

# Optional but recommended: a Canvas API token so the sync can read each
# assignment's EXACT due time. The Canvas calendar feed only contains the due
# DATE, not the time, so without this, due times fall back to 23:59 local.
# Generate at: Canvas > Account > Settings > "+ New Access Token".
# Treat it like a password - it can read your Canvas data.
CANVAS_API_TOKEN=
# Defaults to the host of CANVAS_ICS_URL (e.g. https://fau.instructure.com).
# Only set this if your API host differs from your feed host.
CANVAS_API_BASE=

# Your own Anthropic API key (console.anthropic.com) - only needed when an
# explicitly invoked agent command uses the Anthropic model adapter. sync.py,
# local research, diagnostics, link checks, and saved-response replays never use it.
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Provider-neutral concept analysis. Supported built-in adapters are
# "anthropic" and "openai-compatible". OpenAI-compatible endpoints include
# hosted APIs and local servers such as Ollama or LM Studio.
MODEL_PROVIDER=anthropic
MODEL_NAME=
# Anthropic defaults are explicit so a model upgrade cannot silently increase
# reasoning spend. Use high only for Expert-mode work that needs deeper proofs.
MODEL_EFFORT=medium
MODEL_THINKING=adaptive
# Required only for openai-compatible providers, e.g. http://localhost:11434/v1
MODEL_BASE_URL=
MODEL_API_KEY=

# Provider-neutral, model-free web discovery is separately opt-in. Do not use an
# untrusted public SearXNG instance for coursework queries. HTTPS is required
# except for an exact loopback host such as http://127.0.0.1:8080.
RESEARCH_PROVIDER=
SEARXNG_BASE_URL=
# Optional. Defaults outside the repository/vault under the local app-data
# directory and stores only normalized public result metadata, never the raw
# request/provider payload. Treat it as sensitive because snippets can echo terms.
RESEARCH_CACHE_PATH=
# Optional telemetry estimate. Leave blank when total per-request cost is unknown.
RESEARCH_COST_PER_REQUEST_USD=
